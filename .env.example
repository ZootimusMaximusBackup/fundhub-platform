# Core
DATABASE_URL=postgres://user:password@host:5432/dbname
DASHBOARD_SECRET=pick-a-long-random-secret
NODE_ENV=development
DEFAULT_ORG_SLUG=fundhub

# Inngest — workflow automation (47 functions at /api/inngest)
# Get from: https://app.inngest.com → your app → Manage → Keys
INNGEST_EVENT_KEY=             # required in production; bridge is inert without it
INNGEST_SIGNING_KEY=           # required in production

# Webhook secrets. EVERY adapter fails CLOSED without its secret: an unsigned
# webhook is refused with 401 and nothing reaches the event bus. That is
# deliberate — mailgun used to skip verification when its key was blank, which
# let anyone POST a forged bank email onto the bus.
COMMAS_WEBHOOK_SECRET=
TWILIO_AUTH_TOKEN=
MAILGUN_SIGNING_KEY=
CALCOM_WEBHOOK_SECRET=
BLAND_WEBHOOK_SECRET=
CLICKFUNNELS_WEBHOOK_SECRET=
# Sole producer of round.started / round.submitted / round.approved /
# round.funded. Without this, eight funding workflows have no trigger.
LENDFLOW_WEBHOOK_SECRET=
LENDFLOW_API_KEY=

# Inquiry-removal runtime (external). /api/inquiry answers 503 not_configured
# until this is set, which is the normal local state.
INQUIRY_API_SECRET=
INQUIRY_API_BASE=

# Signs document download links (src/documents/retrieve.mjs). NOTE: the route
# those links point at, /api/documents/<id>, does not exist yet — see HANDOFF.
DOCUMENT_URL_SECRET=

# Postgres client tuning. Defaults are set in src/db.mjs; override for a slow
# link or a deliberately long migration run.
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
