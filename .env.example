# Core
DATABASE_URL=postgres://user:password@host:5432/dbname
DASHBOARD_SECRET=pick-a-long-random-secret
NODE_ENV=development
DEFAULT_ORG_SLUG=fundhub

# Inngest — workflow automation (47 functions at /api/inngest)
# Get from: https://app.inngest.com → your app → Manage → Keys
INNGEST_EVENT_KEY=             # required in production; bridge is inert without it
INNGEST_SIGNING_KEY=           # required in production

# Webhook secrets (add when wiring live sources)
COMMAS_WEBHOOK_SECRET=
TWILIO_AUTH_TOKEN=
MAILGUN_SIGNING_KEY=
CALCOM_WEBHOOK_SECRET=
BLAND_WEBHOOK_SECRET=
CLICKFUNNELS_WEBHOOK_SECRET=

# ── Creative Factory + Campaign Manager (045-050) ────────────────────────────
# REQUIRED. 32 bytes, base64. Encrypts partner OAuth tokens at rest (AES-256-GCM,
# with the partner id as additional authenticated data). Token storage REFUSES to
# run without it rather than storing plaintext — that refusal is deliberate.
# Generate: openssl rand -base64 32
AD_TOKEN_ENC_KEY=
# Optional: after a rotation, the previous key stays readable under its own id.
# AD_TOKEN_ENC_KEY_V2=

# Ad platform API versions. Pinned rather than floating, so a platform's breaking
# change is a deliberate bump.
META_API_VERSION=v21.0
TIKTOK_API_VERSION=v1.3

# Generation provider keys. FUNDHUB-LEVEL — never partner-supplied, never returned
# by an API response. A provider whose key is unset throws naming the ENV VAR only.
CREATIVE_STATIC_API_KEY=
CREATIVE_UGC_API_KEY=
CREATIVE_PRODUCT_VIDEO_API_KEY=
CREATIVE_COPY_API_KEY=
CREATIVE_RESIZE_API_KEY=

# ── Hiring (051-053) ─────────────────────────────────────────────────────────
# LinkedIn Talent Solutions. Partner-gated; used to POST jobs and INGEST
# applications people submitted. There is no profile-read scope here on purpose —
# see the header of src/hiring/linkedin.mjs.
LINKEDIN_API_VERSION=202405
