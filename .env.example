# Local development template. Copy to .env and fill in.
# Production reads the same names from Netlify. When you change one, change both.
# Never commit .env.

# Postgres (local or pooler). Production DATABASE_URL is set only in Netlify.
DATABASE_URL=
# Admin/owner URL for migrations (fundhub_app cannot alter schema).
MIGRATION_DATABASE_URL=

# Agent runtime (src/agents/model.mjs). Unset = shadow mode (logs, sends nothing).
ANTHROPIC_API_KEY=

# Oxylabs residential Apply door (src/adapters/oxylabs.mjs).
# Username WITHOUT the customer- prefix — the adapter adds it.
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# Mailgun outbound email (src/messaging/providers/mailgun.mjs).
MAILGUN_SEND_API_KEY=
MAILGUN_SEND_DOMAIN=
MAILGUN_SEND_FROM=
# Optional EU region: https://api.eu.mailgun.net
# MAILGUN_SEND_BASE_URL=

# GoHighLevel / LeadConnector (src/messaging/ghl-contacts.mjs).
# GHL_API_KEY preferred; GHL_RELAY_API_KEY accepted as fallback.
GHL_API_KEY=
GHL_RELAY_API_KEY=

# Document download link signing.
DOCUMENT_URL_SECRET=

# Encrypts partner OAuth tokens at rest (AES-256-GCM). Generate: openssl rand -base64 32
AD_TOKEN_ENC_KEY=

# Encrypts SSN / PII at rest. Separate from AD_TOKEN_ENC_KEY on purpose.
PII_ENC_KEY=

# Sole producer of round.started / round.submitted / round.approved / round.funded.
LENDFLOW_WEBHOOK_SECRET=
LENDFLOW_API_KEY=

# Inquiry-removal runtime (external).
INQUIRY_API_SECRET=
INQUIRY_API_BASE=

# Creative Factory provider keys (fundhub-level — never partner-supplied).
CREATIVE_STATIC_API_KEY=
CREATIVE_UGC_API_KEY=
CREATIVE_PRODUCT_VIDEO_API_KEY=
CREATIVE_COPY_API_KEY=
CREATIVE_RESIZE_API_KEY=

# Ad platform API versions (pinned).
META_API_VERSION=v21.0
TIKTOK_API_VERSION=v1.3

# LinkedIn Talent Solutions API version.
LINKEDIN_API_VERSION=202405

# Postgres client tuning (defaults in src/db.mjs).
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000

# DO NOT set locally unless you intend to wake production workflow fans-out.
# Owner gate — flipping this on Netlify wakes 47 Inngest functions.
# INNGEST_EVENT_KEY=
