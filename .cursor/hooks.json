{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/warn-secret-stage.cjs",
        "matcher": "git\\s+(add|commit|stage|rm|mv)\\b",
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "but cursor after-edit"
      }
    ],
    "stop": [
      {
        "command": "but cursor stop"
      }
    ]
  }
}
