# Bland AI
BLAND_API_KEY=org_xxx

# Bland AI voice (911 voices: mason, david, josh, etc.)
BLAND_VOICE=mason

# Bland AI webhook signature verification (optional — skipped if not set)
BLAND_WEBHOOK_SECRET=

# Bland call completion callback (Fundhub inbound — not Vercel /api/*-webhook)
BLAND_WEBHOOK_URL=https://fundhub.ai/api/webhooks/bland

# Experian IVR Number
EXPERIAN_DISPUTE_NUMBER=+18883973742

# FundHub Rep Transfer Number
FUNDHUB_REP_NUMBER=+1xxxxxxxxxx

# API auth — Bearer token for launch-call, schedule-call, call-status endpoints
API_SECRET=

# Cron auth — Bearer token for dispatch-scheduled endpoint (Vercel Cron)
CRON_SECRET=

# Airtable (for client data / status updates)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# GoHighLevel (for CRM status updates) — Fundhub cutover: leave unset
GHL_PRIVATE_API_KEY=
GHL_LOCATION_ID=
