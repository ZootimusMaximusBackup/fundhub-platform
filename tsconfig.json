{
  // WHY THIS FILE EXISTS (added 2026-08-27).
  //
  // CLAUDE.md §6 lists `npx tsc --noEmit` as a gate that must pass before any
  // task is reported done. There was no tsconfig.json in the repo, so tsc found
  // no inputs, printed its own --help, and exited 0. The gate passed by checking
  // NOTHING. It had been "green" that way for its whole life.
  //
  // checkJs is deliberately OFF. Measured 2026-08-27 with checkJs:true across
  // src/ api/ scripts/ db/: 5393 errors (2408 TS2353, 2088 TS2339, 391 TS2345).
  // Turning it on wholesale would leave the gate permanently red, which is worse
  // than leaving it vacuous — a red gate teaches everyone to ignore it.
  //
  // So: this config parses every .mjs and resolves every module, and any file
  // that opts in with a `// @ts-check` line on top gets FULL type checking.
  // Verified 2026-08-27 that the opt-in really bites — a wrong argument type in
  // a @ts-check file fails this gate with TS2345.
  //
  // To tighten coverage, add `// @ts-check` to one more file and fix what it
  // reports. Do not flip checkJs globally until that number is near zero.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.mjs", "api/**/*.mjs", "scripts/**/*.mjs", "db/**/*.mjs"]
}
