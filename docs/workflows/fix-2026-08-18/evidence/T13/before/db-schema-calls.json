    },
    {
      "conname": "agents_retired_ck",
      "def": "CHECK (((status = 'retired'::text) = (retired_at IS NOT NULL)))"
    },
    {
      "conname": "agents_runtime_required_ck",
      "def": "CHECK (((status <> ALL (ARRAY['live'::text, 'shadow'::text])) OR (runtime IS NOT NULL)))"
    },
    {
